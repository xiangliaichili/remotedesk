# remotedesk 服务器环境变量示例（复制为 .env 后按需修改）
# 完整的部署说明见仓库根目录 README.md 的「8. 服务器部署」与「8.5 配置登录方式」。

# ---------- 基础配置 ----------
# 对外访问地址：客户端据此连接（HTTPS 域名，反代到 8443）
RD_PUBLIC=https://rd.example.com
# 你的部署域名（Caddy 自动申请证书用）
RD_DOMAIN=rd.example.com
# 监听地址（容器/主机内）
RD_LISTEN=:8443
# TURN 中继对外 IP（通常是云服务器公网 IP；留空则从 RD_PUBLIC 推导）
RD_TURN_RELAY_IP=203.0.113.10
RD_TURN_LISTEN=:3478
# JWT 签名密钥（务必改成随机长串）
RD_JWT_SECRET=please-change-this-to-a-random-64-char-string
# SQLite 数据库文件
RD_DB=/data/remotedesk.db

# ---------- 登录方式（可只开账号密码） ----------
# 短信验证码：off=关闭（客户端隐藏入口）/ mock=只写日志（联调）/ aliyun=真实发送
RD_SMS_PROVIDER=off
# 阿里云短信（控制台申请签名与模板，模板正文里用 ${code} 占位）
#RD_SMS_SIGN=某某科技
#RD_SMS_TEMPLATE=SMS_123456789
# 强烈建议用只授 dysms:SendSms 的 RAM 子账号
#RD_ALIYUN_KEY_ID=LTAI...
#RD_ALIYUN_KEY_SECRET=...

# 微信扫码登录（微信开放平台 → 网站应用；回调域填部署域名）
#RD_WECHAT_APP_ID=wx...
#RD_WECHAT_APP_SECRET=...
RD_WECHAT_REDIRECT=https://rd.example.com

# ---------- 开发调试（上线必须为 0） ----------
# =1 时：日志打印验证码、接口回传 dev_code、开放 /api/auth/wechat/dev 模拟扫码
RD_SMS_DEV=0
RD_AUTH_DEV=0
